{
  "manifest_version": 3,
  "name": "کارگاه — مدیریت مال",
  "version": "1.0.0",
  "description": "ثبت سریع هزینه و درآمد در کارگاه، از هر صفحه‌ای.",
  "default_locale": "fa",
  "action": {
    "default_popup": "popup.html",
    "default_title": "کارگاه",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://armvnhs.ir/kargah/*"],
  "content_scripts": [
    {
      "matches": [
        "https://armvnhs.ir/kargah/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
